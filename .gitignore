# ============================================
#  个人数据文件 —— 绝对不要提交到仓库！
# ============================================
# 内含 Steam Web API Key 与你的 Steam ID
config.json
# 内含所有被监控好友的昵称、SteamID 与状态/时长记录
logs/
# 内含好友 SteamID 及其游戏时长历史
playtime_history.json
# 内含好友 SteamID 列表
tracked_friends.json
# 内含好友 SteamID 分组信息
friend_groups.json
# 运行时调试日志（可能含好友昵称）
debug.log

# ============================================
#  Python 运行产物
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# ============================================
#  打包产物
# ============================================
build/
dist/
*.spec
*.exe
*.zip

# ============================================
#  编辑器 / 系统文件
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
#  其他敏感文件
# ============================================
.env
*.local
